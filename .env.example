# Copy to `.env` and fill in from your Supabase project
# (Dashboard → Project Settings → API). Then restart Expo with `npx expo start -c`.
#
# Leave these out entirely and the app still runs — fully local, no accounts, no
# network. The Friends tab explains itself in that state rather than showing anything
# fake, so a local-only build is perfectly shippable.
#
# The EXPO_PUBLIC_ prefix means these are inlined into the JS bundle, which is correct
# for both of these values. The anon key is designed to be public: it grants nothing on
# its own, because every table sits behind row-level security. NEVER put the
# service_role key here — it bypasses every policy.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
